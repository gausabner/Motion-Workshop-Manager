// MOTION Workshop Manager — data model v2 (PRD §7)
// One transaction document (quote → booking → job card → invoice → credit),
// tenant-scoped everything, money as Decimal, nothing hard-deleted.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── enums ─────────────────────────

enum UserGroup {
  OWNER
  ADMIN
  SERVICE_ADVISOR
  MECHANIC
  INVOICE_PAY
  READ_ONLY
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum ContactMethod {
  EMAIL
  SMS
  WHATSAPP
  OPT_OUT
}

enum PriceType {
  RETAIL
  PRICE2
  PRICE3
  PRICE4
}

enum ProductType {
  STOCK
  LABOUR
  SUBLET
  CONSUMABLE
  ACCESSORY
  TYRE
}

enum DocumentType {
  QUOTE
  BOOKING
  JOB_CARD
  INVOICE
  CASH_SALE
  CREDIT
}

enum DocumentState {
  DRAFT
  PROCESSED
  /// Fully settled — derived when the amount due reaches zero, never set by hand
  CLOSED
  VOID
}

enum JobStatus {
  BOOKED_IN
  WORK_IN_PROGRESS
  WAITING_FOR_PARTS
  INSPECTION_IN_PROGRESS
  WAITING_FOR_CUSTOMER_APPROVAL
  JOB_COMPLETE
  CUSTOMER_NOTIFIED
  AWAITING_FINALISE
  FINALISED
}

enum LineType {
  STOCK
  LABOUR
  SUBLET
  CONSUMABLE
  ACCESSORY
  TYRE
  FREIGHT
}

enum PaymentState {
  DRAFT
  PROCESSED
  VOID
}

/// Which way the money went. A refund stores negative tenders, so every sum —
/// account balance, unapplied credit, a day's takings — nets without a special case.
enum PaymentDirection {
  RECEIPT
  REFUND
}

enum CreditKind {
  DEPOSIT
  CREDIT_NOTE
}

enum TimeEntrySource {
  MANUAL
  CLOCK
}

enum TemplateKind {
  INVOICE_NOTE
  JOB_CARD_NOTE
  INVOICE_FOOTER
  QUOTE_FOOTER
  JOB_CARD_FOOTER
  STATEMENT_FOOTER
  EMAIL
  SMS
  /// The text that goes out with a document on WhatsApp or email. Built-in
  /// defaults live in code; a row here is the workshop's own wording.
  MESSAGE_QUOTE
  MESSAGE_JOB_CARD
  MESSAGE_INVOICE
  MESSAGE_CREDIT
  MESSAGE_RECEIPT
  MESSAGE_REFUND
  MESSAGE_STATEMENT
}

enum MessageChannel {
  WHATSAPP
  EMAIL
  SMS
}

/// HANDED_OFF means the message was prepared and opened in the sender's own
/// WhatsApp or mail app — we cannot know whether they pressed send. Whether
/// the customer actually got it is answered by the share link being opened.
enum MessageStatus {
  HANDED_OFF
  SENT
  DELIVERED
  READ
  FAILED
}

enum ShareKind {
  DOCUMENT
  PAYMENT
  STATEMENT
}

enum SequenceKey {
  QUOTE
  JOB
  INVOICE
  CREDIT
  RECEIPT
  REFUND
  PURCHASE_ORDER
  SUPPLIER_PAYMENT
}

// ───────────────────────── tenancy & people ─────────────────────────

model Tenant {
  id                      String   @id @default(cuid())
  slug                    String   @unique
  name                    String
  // Company profile (PRD SET-01)
  registrationNumber      String?
  vatNumber               String?
  address1                String?
  address2                String?
  suburb                  String?
  city                    String?
  region                  String?
  postcode                String?
  country                 String   @default("NA")
  phone                   String?
  mobile                  String?
  whatsapp                String?
  email                   String?
  web                     String?
  timezone                String   @default("Africa/Windhoek")
  currency                String   @default("NAD")
  locale                  String   @default("en-NA")
  // Tax defaults (PRD SET-02) — rates are percentages, e.g. 15.00
  taxName                 String   @default("VAT")
  salesTaxRate            Decimal  @default(15.00) @db.Decimal(5, 2)
  purchaseTaxRate         Decimal  @default(15.00) @db.Decimal(5, 2)
  pricesIncludeTax        Boolean  @default(true)
  defaultPaymentTermsDays Int      @default(0)
  // Everything else lives in a typed JSON blob validated by zod (PRD SET-09)
  settings                Json     @default("{}")
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  memberships       Membership[]
  invitations       Invitation[]
  sessions          Session[]
  customers         Customer[]
  contacts          Contact[]
  vehicles          Vehicle[]
  suppliers         Supplier[]
  productGroups     ProductGroup[]
  productCategories ProductCategory[]
  products          Product[]
  customerSources   CustomerSource[]
  paymentMethods    PaymentMethod[]
  appointmentTypes  AppointmentType[]
  sequences         Sequence[]
  templates         Template[]
  documents         Document[]
  documentLines     DocumentLine[]
  statusEvents      DocumentStatusEvent[]
  timeEntries       TimeEntry[]
  payments          Payment[]
  paymentTenders    PaymentTender[]
  allocations       PaymentAllocation[]
  credits           Credit[]
  attachments       Attachment[]
  auditEvents       AuditEvent[]
  externalRefs      ExternalRef[]
  shareLinks        ShareLink[]
  messages          Message[]
  workingHours      WorkingHours[]
  timeOff           TimeOff[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  mobile       String?
  isSuperuser  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     Membership[]
  sessions        Session[]
  invitationsSent Invitation[] @relation("InvitedBy")
  auditEvents     AuditEvent[]
}

/// A person inside a workshop. Advisors, mechanics and document authors all
/// point here, never at User, so a user can belong to several workshops.
model Membership {
  id                  String           @id @default(cuid())
  tenantId            String
  userId              String
  group               UserGroup        @default(SERVICE_ADVISOR)
  status              MembershipStatus @default(ACTIVE)
  isMechanic          Boolean          @default(false)
  isServiceAdvisor    Boolean          @default(false)
  dashboardPrivileges Boolean          @default(false)
  limitCustomerInfo   Boolean          @default(false)
  showOnDiary         Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  advisedDocuments   Document[]            @relation("DocumentAdvisor")
  mechanicDocuments  Document[]            @relation("DocumentMechanic")
  createdDocuments   Document[]            @relation("DocumentCreatedBy")
  processedDocuments Document[]            @relation("DocumentProcessedBy")
  statusEvents       DocumentStatusEvent[]
  timeEntries        TimeEntry[]
  paymentsTaken      Payment[]
  messages           Message[]
  workingHours       WorkingHours[]
  timeOff            TimeOff[]

  @@unique([userId, tenantId])
  @@index([tenantId, status])
}

model Invitation {
  id          String    @id @default(cuid())
  tenantId    String
  email       String
  group       UserGroup @default(SERVICE_ADVISOR)
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  createdAt   DateTime  @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  invitedBy User   @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([tenantId, email])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String?
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([userId])
}

// ───────────────────────── master data ─────────────────────────

model Customer {
  id               String        @id @default(cuid())
  tenantId         String
  firstName        String
  lastName         String
  isBusiness       Boolean       @default(false)
  /// Parent account that gets the invoice (PRD CUST-02 "biller")
  billerId         String?
  businessNumber   String?
  vatNumber        String?
  // Street + postal address (WS dual addressing)
  streetAddress1   String?
  streetAddress2   String?
  streetSuburb     String?
  streetCity       String?
  streetRegion     String?
  streetCountry    String?
  streetPostcode   String?
  postalAddress1   String?
  postalAddress2   String?
  postalSuburb     String?
  postalCity       String?
  postalRegion     String?
  postalCountry    String?
  postalPostcode   String?
  phone            String?
  mobile           String?
  email            String?
  fax              String?
  web              String?
  preferredContact ContactMethod @default(WHATSAPP)
  // Pricing & terms
  hourlyRate       Decimal?      @db.Decimal(12, 2)
  discountPercent  Decimal       @default(0) @db.Decimal(5, 2)
  markupPercent    Decimal       @default(0) @db.Decimal(5, 2)
  priceType        PriceType     @default(RETAIL)
  paymentTermsDays Int?
  creditLimit      Decimal?      @db.Decimal(12, 2)
  vatExempt        Boolean       @default(false)
  customerSourceId String?
  importedId       String?
  note             String?
  archivedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  biller         Customer?       @relation("Biller", fields: [billerId], references: [id])
  billedAccounts Customer[]      @relation("Biller")
  customerSource CustomerSource? @relation(fields: [customerSourceId], references: [id])
  contacts       Contact[]
  vehicles       Vehicle[]
  documents      Document[]
  payments       Payment[]
  credits        Credit[]
  messages       Message[]

  @@index([tenantId, lastName, firstName])
  @@index([tenantId, mobile])
  @@index([tenantId, archivedAt])
}

model Contact {
  id         String  @id @default(cuid())
  tenantId   String
  customerId String?
  supplierId String?
  firstName  String
  lastName   String?
  position   String?
  phone      String?
  mobile     String?
  email      String?
  sortOrder  Int     @default(0)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([supplierId])
}

model Vehicle {
  id                    String    @id @default(cuid())
  tenantId              String
  customerId            String?
  plate                 String
  vin                   String?
  make                  String
  model                 String
  modelSeries           String?
  year                  Int?
  engineNumber          String?
  chassisNumber         String?
  engineCode            String?
  fleetCode             String?
  vehicleGroup          String?
  /// Group-specific fields (marine, trailer, plant…) validated by a zod schema per vehicleGroup
  extras                Json      @default("{}")
  bodyType              String?
  transmission          String?
  driveType             String?
  fuelType              String?
  cylinders             Int?
  litres                Decimal?  @db.Decimal(4, 1)
  hasAc                 Boolean   @default(false)
  seating               Int?
  colour                String?
  tyreSize              String?
  keyCode               String?
  radioPin              String?
  buildDate             DateTime? @db.Date
  odometer              Int?
  engineHours           Decimal?  @db.Decimal(10, 1)
  // Compliance (localised: licence disc + roadworthy, PRD VEH-02)
  licenceExpiry         DateTime? @db.Date
  roadworthyExpiry      DateTime? @db.Date
  // Servicing
  lastInDate            DateTime? @db.Date
  lastServiceDate       DateTime? @db.Date
  nextServiceDate       DateTime? @db.Date
  nextServiceKm         Int?
  serviceIntervalMonths Int?
  importedId            String?
  note                  String?
  archivedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  customer  Customer?  @relation(fields: [customerId], references: [id])
  documents Document[]

  @@index([tenantId, plate])
  @@index([tenantId, vin])
  @@index([tenantId, customerId])
}

model Supplier {
  id               String    @id @default(cuid())
  tenantId         String
  companyName      String
  accountNumber    String?
  vatNumber        String?
  address1         String?
  address2         String?
  suburb           String?
  city             String?
  region           String?
  country          String?
  postcode         String?
  phone            String?
  mobile           String?
  email            String?
  fax              String?
  web              String?
  paymentTermsDays Int?
  importedId       String?
  note             String?
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  contacts Contact[]
  products Product[]

  @@index([tenantId, companyName])
}

model ProductGroup {
  id              String  @id @default(cuid())
  tenantId        String
  name            String
  salesAccount    String?
  purchaseAccount String?
  sortOrder       Int     @default(0)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@unique([tenantId, name])
}

model ProductCategory {
  id        String @id @default(cuid())
  tenantId  String
  name      String
  sortOrder Int    @default(0)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@unique([tenantId, name])
}

model Product {
  id               String      @id @default(cuid())
  tenantId         String
  itemCode         String
  description      String
  description2     String?
  tags             String?
  groupId          String?
  categoryId       String?
  supplierId       String?
  brand            String?
  type             ProductType @default(STOCK)
  isService        Boolean     @default(false)
  vatExempt        Boolean     @default(false)
  dontUpdateQty    Boolean     @default(false)
  requiresSerial   Boolean     @default(false)
  defaultLabourQty Decimal?    @db.Decimal(8, 2)
  qtyOnHand        Decimal     @default(0) @db.Decimal(12, 2)
  qtyReserved      Decimal     @default(0) @db.Decimal(12, 2)
  minQty           Decimal     @default(0) @db.Decimal(12, 2)
  maxQty           Decimal     @default(0) @db.Decimal(12, 2)
  location         String?
  costExTax        Decimal     @default(0) @db.Decimal(12, 2)
  costIncTax       Decimal     @default(0) @db.Decimal(12, 2)
  retailPrice      Decimal     @default(0) @db.Decimal(12, 2)
  price2           Decimal     @default(0) @db.Decimal(12, 2)
  price3           Decimal     @default(0) @db.Decimal(12, 2)
  price4           Decimal     @default(0) @db.Decimal(12, 2)
  importedId       String?
  comment          String?
  jobCardComment   String?
  archivedAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  group    ProductGroup?    @relation(fields: [groupId], references: [id])
  category ProductCategory? @relation(fields: [categoryId], references: [id])
  supplier Supplier?        @relation(fields: [supplierId], references: [id])
  lines    DocumentLine[]

  @@unique([tenantId, itemCode])
  @@index([tenantId, description])
}

// ───────────────────────── lists & config (PRD SET-06/07/08) ─────────────────────────

model CustomerSource {
  id        String  @id @default(cuid())
  tenantId  String
  name      String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  customers Customer[]
  documents Document[]

  @@unique([tenantId, name])
}

model PaymentMethod {
  id           String  @id @default(cuid())
  tenantId     String
  name         String
  code         String
  isEft        Boolean @default(false)
  isIntegrated Boolean @default(false)
  active       Boolean @default(true)
  sortOrder    Int     @default(0)

  tenant  Tenant          @relation(fields: [tenantId], references: [id])
  tenders PaymentTender[]

  @@unique([tenantId, code])
}

model AppointmentType {
  id             String  @id @default(cuid())
  tenantId       String
  description    String
  estimatedHours Decimal @default(1) @db.Decimal(5, 2)
  active         Boolean @default(true)
  sortOrder      Int     @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, description])
}

model Sequence {
  id       String      @id @default(cuid())
  tenantId String
  key      SequenceKey
  prefix   String      @default("")
  next     Int         @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
}

model Template {
  id        String       @id @default(cuid())
  tenantId  String
  kind      TemplateKind
  name      String
  body      String
  sortOrder Int          @default(0)
  active    Boolean      @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, kind])
}

// ───────────────────────── the transaction document (PRD §6.4) ─────────────────────────

model Document {
  id                  String        @id @default(cuid())
  tenantId            String
  type                DocumentType
  state               DocumentState @default(DRAFT)
  jobStatus           JobStatus?
  statusComment       String?
  /// Type-specific number: Q-1001, JC-1001, INV-1001, CR-1001 (PRD DOC-11)
  number              String?
  /// Job card number carried from job to invoice
  jobNumber           String?
  customerId          String?
  isCashSale          Boolean       @default(false)
  vehicleId           String?
  serviceAdvisorId    String?
  mechanicId          String?
  reference           String?
  /// Auto-filled from the first line so lists and statements can say what the
  /// job actually was. The benchmark's trick, and free readability everywhere.
  description         String?
  customerOrderNumber String?
  postDate            DateTime      @default(now()) @db.Date
  dueDate             DateTime?     @db.Date
  followUpDate        DateTime?     @db.Date
  // Booking / diary fields
  scheduledAt         DateTime?
  scheduledEnd        DateTime?
  dueBy               DateTime?
  estimatedHours      Decimal?      @db.Decimal(5, 2)
  // Vehicle capture on the job (PRD DOC-01)
  odometer            Int?
  engineHours         Decimal?      @db.Decimal(10, 1)
  nextServiceKm       Int?
  nextServiceDate     DateTime?     @db.Date
  isInternal          Boolean       @default(false)
  paymentTermsDays    Int?
  customerSourceId    String?
  // Tax snapshot — stamped at creation and never read from the tenant again (R1c)
  taxName             String        @default("VAT")
  taxRate             Decimal       @default(15.00) @db.Decimal(5, 2)
  pricesIncludeTax    Boolean       @default(true)
  // Money — all stored, recomputed by the service layer on every line change
  subtotal            Decimal       @default(0) @db.Decimal(12, 2)
  discountPercent     Decimal?      @db.Decimal(5, 2)
  discountAmount      Decimal       @default(0) @db.Decimal(12, 2)
  freight             Decimal       @default(0) @db.Decimal(12, 2)
  vatTotal            Decimal       @default(0) @db.Decimal(12, 2)
  discountApplied     Decimal       @default(0) @db.Decimal(12, 2)
  unroundedTotal      Decimal       @default(0) @db.Decimal(12, 2)
  rounding            Decimal       @default(0) @db.Decimal(12, 2)
  total               Decimal       @default(0) @db.Decimal(12, 2)
  // Paid and due are derived from PaymentAllocation — never stored here (R1c)
  // Notes
  eventNotes          String?
  jobCardNotes        String?
  invoiceNotes        String?
  contactedAt         DateTime?
  // Lifecycle
  processedAt         DateTime?
  processedById       String?
  voidedAt            DateTime?
  voidReason          String?
  /// Copy / convert / credit origin
  sourceDocumentId    String?
  createdById         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  tenant           Tenant                @relation(fields: [tenantId], references: [id])
  customer         Customer?             @relation(fields: [customerId], references: [id])
  vehicle          Vehicle?              @relation(fields: [vehicleId], references: [id])
  serviceAdvisor   Membership?           @relation("DocumentAdvisor", fields: [serviceAdvisorId], references: [id])
  mechanic         Membership?           @relation("DocumentMechanic", fields: [mechanicId], references: [id])
  createdBy        Membership?           @relation("DocumentCreatedBy", fields: [createdById], references: [id])
  processedBy      Membership?           @relation("DocumentProcessedBy", fields: [processedById], references: [id])
  customerSource   CustomerSource?       @relation(fields: [customerSourceId], references: [id])
  sourceDocument   Document?             @relation("DocumentSource", fields: [sourceDocumentId], references: [id])
  derivedDocuments Document[]            @relation("DocumentSource")
  lines            DocumentLine[]
  statusEvents     DocumentStatusEvent[]
  timeEntries      TimeEntry[]
  allocations      PaymentAllocation[]
  credits          Credit[]
  messages         Message[]

  @@index([tenantId, type, state])
  @@index([tenantId, number])
  @@index([tenantId, customerId])
  @@index([tenantId, vehicleId])
  @@index([tenantId, scheduledAt])
  @@index([tenantId, jobStatus])
}

model DocumentLine {
  id                 String   @id @default(cuid())
  tenantId           String
  documentId         String
  sortOrder          Int      @default(0)
  productId          String?
  lineType           LineType @default(STOCK)
  description        String
  quantity           Decimal  @default(1) @db.Decimal(12, 2)
  /// Labour hours worked on this line (benchmark: invoice_items.hours_worked)
  hours              Decimal? @db.Decimal(8, 2)
  unitPrice          Decimal  @default(0) @db.Decimal(12, 2)
  unitCost           Decimal  @default(0) @db.Decimal(12, 2)
  /// Percentage, e.g. 15.00; 0 for exempt lines
  vatRate            Decimal  @default(0) @db.Decimal(5, 2)
  discountPercent    Decimal  @default(0) @db.Decimal(5, 2)
  lineSubtotal       Decimal  @default(0) @db.Decimal(12, 2)
  vatAmount          Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal          Decimal  @default(0) @db.Decimal(12, 2)
  serialNumbers      String?
  isCustomerSupplied Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id])

  @@index([documentId, sortOrder])
  @@index([tenantId, productId])
}

model DocumentStatusEvent {
  id         String     @id @default(cuid())
  tenantId   String
  documentId String
  fromStatus JobStatus?
  toStatus   JobStatus
  comment    String?
  byId       String?
  at         DateTime   @default(now())

  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  document Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  by       Membership? @relation(fields: [byId], references: [id])

  @@index([documentId, at])
}

/// A mechanic's own hours on one weekday, where they differ from the shop's.
/// No row means the shop's hours; equal start and end means a regular day off.
/// Only the exceptions are stored — the benchmark's "Hide Defaults".
model WorkingHours {
  id           String @id @default(cuid())
  tenantId     String
  membershipId String
  /// ISO weekday, 1 = Monday.
  weekday      Int
  startMinute  Int
  endMinute    Int

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, weekday])
  @@index([tenantId])
}

/// Leave, a course, a doctor's appointment — the benchmark's "Unavailable Times".
model TimeOff {
  id           String   @id @default(cuid())
  tenantId     String
  membershipId String
  startsAt     DateTime
  endsAt       DateTime
  reason       String?
  createdById  String?
  createdAt    DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([tenantId, startsAt])
  @@index([membershipId, startsAt])
}

model TimeEntry {
  id         String          @id @default(cuid())
  tenantId   String
  documentId String
  mechanicId String
  source     TimeEntrySource @default(MANUAL)
  startedAt  DateTime
  endedAt    DateTime?
  minutes    Int?
  note       String?
  createdAt  DateTime        @default(now())

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  document Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  mechanic Membership @relation(fields: [mechanicId], references: [id])

  @@index([tenantId, mechanicId, startedAt])
  @@index([documentId])
}

// ───────────────────────── money in (PRD §6.11) ─────────────────────────

model Payment {
  id          String           @id @default(cuid())
  tenantId    String
  /// Null only while the receipt is still a draft on the counter.
  customerId  String?
  direction   PaymentDirection @default(RECEIPT)
  state       PaymentState     @default(DRAFT)
  /// Receipt number from the RECEIPT sequence, allocated on process
  number      String?
  postDate    DateTime         @default(now()) @db.Date
  /// Sum of the tenders. What is allocated is derived; the remainder is unapplied credit.
  amount      Decimal          @default(0) @db.Decimal(12, 2)
  note        String?
  takenById   String?
  processedAt DateTime?
  voidedAt    DateTime?
  voidReason  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  customer    Customer?           @relation(fields: [customerId], references: [id])
  takenBy     Membership?         @relation(fields: [takenById], references: [id])
  tenders     PaymentTender[]
  allocations PaymentAllocation[]
  credits     Credit[]
  messages    Message[]

  @@index([tenantId, customerId, postDate])
  @@index([tenantId, state])
}

/// How the money arrived. A counter payment is often split across cash, card and
/// EFT, and each tender carries its own reference (benchmark verified).
model PaymentTender {
  id                String   @id @default(cuid())
  tenantId          String
  paymentId         String
  methodId          String
  amount            Decimal  @db.Decimal(12, 2)
  /// What was physically handed over, when that is more than what was kept —
  /// the difference is the change given. Null means they gave the exact amount.
  tendered          Decimal? @db.Decimal(12, 2)
  /// EFT reference, card slip or cheque number
  reference         String?
  proofAttachmentId String?
  sortOrder         Int      @default(0)

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  payment Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  method  PaymentMethod @relation(fields: [methodId], references: [id])

  @@index([paymentId])
}

model PaymentAllocation {
  id         String  @id @default(cuid())
  tenantId   String
  paymentId  String
  documentId String
  amount     Decimal @db.Decimal(12, 2)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  payment  Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id])

  @@unique([paymentId, documentId])
  @@index([documentId])
}

/// Deposits and credit notes held on a customer's account (PRD PAY-04).
/// A deposit is a child of the document it was taken against, via sourceDocumentId.
model Credit {
  id               String     @id @default(cuid())
  tenantId         String
  customerId       String
  kind             CreditKind
  amount           Decimal    @db.Decimal(12, 2)
  remaining        Decimal    @db.Decimal(12, 2)
  sourceDocumentId String?
  paymentId        String?
  note             String?
  createdAt        DateTime   @default(now())

  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  customer       Customer  @relation(fields: [customerId], references: [id])
  sourceDocument Document? @relation(fields: [sourceDocumentId], references: [id])
  payment        Payment?  @relation(fields: [paymentId], references: [id])

  @@index([tenantId, customerId])
}

// ───────────────────────── files & audit ─────────────────────────

model Attachment {
  id           String   @id @default(cuid())
  tenantId     String
  ownerType    String
  ownerId      String
  /// Which storage driver wrote this object. Kept per file so a workshop that
  /// moves from local disk to a bucket keeps reading everything from before.
  driver       String   @default("local")
  storageKey   String
  fileName     String
  mimeType     String
  size         Int
  /// sha256 of the bytes as stored, for integrity checks and de-duplication.
  checksum     String?
  uploadedById String?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, ownerType, ownerId])
}

/// A link a customer can open without an account. Only the hash of the token
/// is stored, so the table leaking does not leak working links.
model ShareLink {
  id            String    @id @default(cuid())
  tenantId      String
  tokenHash     String    @unique
  kind          ShareKind
  /// Document id, payment id, or — for a statement — the customer id.
  targetId      String
  /// The statement window, when kind is STATEMENT.
  params        Json      @default("{}")
  expiresAt     DateTime
  revokedAt     DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  firstOpenedAt DateTime?
  lastOpenedAt  DateTime?
  openCount     Int       @default(0)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  messages Message[]

  @@index([tenantId, kind, targetId])
}

/// Every message sent to a customer, whatever the channel — the communication log.
model Message {
  id          String         @id @default(cuid())
  tenantId    String
  customerId  String?
  documentId  String?
  paymentId   String?
  shareLinkId String?
  channel     MessageChannel
  /// Which driver carried it: "whatsapp-link", "mailto", later a provider.
  driver      String
  status      MessageStatus
  recipient   String
  subject     String?
  body        String
  externalId  String?
  error       String?
  sentById    String?
  createdAt   DateTime       @default(now())

  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  customer  Customer?   @relation(fields: [customerId], references: [id])
  document  Document?   @relation(fields: [documentId], references: [id])
  payment   Payment?    @relation(fields: [paymentId], references: [id])
  shareLink ShareLink?  @relation(fields: [shareLinkId], references: [id])
  sentBy    Membership? @relation(fields: [sentById], references: [id])

  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, documentId])
  @@index([tenantId, paymentId])
}

model AuditEvent {
  id          String   @id @default(cuid())
  tenantId    String
  actorUserId String?
  entityType  String
  entityId    String
  action      String
  diff        Json?
  at          DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  actor  User?  @relation(fields: [actorUserId], references: [id])

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, at])
}

// ───────────────────────── integrations ─────────────────────────

/// One row per (entity, provider) link. Integrations never add columns to core
/// tables — the benchmark's invoice carries ~40 sync columns; ours carries none.
model ExternalRef {
  id         String    @id @default(cuid())
  tenantId   String
  entityType String
  entityId   String
  provider   String
  externalId String
  syncState  String    @default("SYNCED")
  syncedAt   DateTime?
  lastError  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, provider, entityType, entityId])
  @@index([tenantId, provider, externalId])
}
