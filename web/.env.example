# Copy to .env and fill in. Local Postgres comes from ../docker-compose.yml (docker compose up -d db).
# The application connects as a role that owns the tables but is NOT a
# superuser. That is deliberate: row-level security is enabled on every table
# holding a workshop's work, and a superuser ignores every policy — so a
# superuser connection here means mistakes stay invisible until production.
# It is also the shape managed Postgres gives you, Render included.
#
# To create it locally, once:
#   CREATE ROLE motion_dev LOGIN PASSWORD 'devonly' NOSUPERUSER NOBYPASSRLS;
#   GRANT ALL ON SCHEMA public TO motion_dev;
#   -- then hand it the tables:
#   DO $$ DECLARE r record; BEGIN
#     FOR r IN SELECT tablename FROM pg_tables WHERE schemaname='public' LOOP
#       EXECUTE format('ALTER TABLE public.%I OWNER TO motion_dev', r.tablename);
#     END LOOP; END $$;
DATABASE_URL="postgresql://motion_dev:devonly@localhost:5432/motion_app?schema=public"

# Used only by `npm run test:db`. Building fixtures across tenants is exactly
# what the policies forbid, so the suite needs full rights; the policies
# themselves are tested in rls.dbtest.ts, which opens its own restricted
# connection on purpose.
DATABASE_URL_ADMIN="postgresql://postgres:postgres@localhost:5432/motion_app?schema=public"
# 32+ random bytes, e.g. `openssl rand -hex 32`. Used to derive session-token hashes.
SESSION_SECRET="change-me"

# ── File storage ──────────────────────────────────────────────────────────────
# Where uploaded files (EFT proofs of payment, photos) are kept. One codebase
# serves both: "local" writes to disk, "s3" writes to any S3-compatible bucket
# (AWS S3, Cloudflare R2, MinIO, Backblaze B2, DigitalOcean Spaces).
#
# Each stored file records the driver that wrote it, so switching is a config
# change — everything written before the switch keeps being readable.
STORAGE_DRIVER="local"

# local
STORAGE_LOCAL_ROOT=".data/attachments"

# s3 — only read when STORAGE_DRIVER="s3"
# STORAGE_S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# STORAGE_S3_BUCKET="motion-attachments"
# STORAGE_S3_REGION="auto"
# STORAGE_S3_ACCESS_KEY_ID=""
# STORAGE_S3_SECRET_ACCESS_KEY=""
# MinIO and most self-hosted gateways need the bucket in the path instead of the host.
# STORAGE_S3_FORCE_PATH_STYLE="false"

# ── Messaging ─────────────────────────────────────────────────────────────────
# Documents go out as a link to the PDF. APP_URL is the address customers are
# sent — set it in production, or links will point wherever the sender happened
# to be browsing from.
# APP_URL="https://app.motion.na"
#
# Which driver carries each channel. The defaults need no account: they open the
# sender's own WhatsApp or mail app with the message typed out. A provider
# (WhatsApp Cloud API, SMTP) plugs in behind the same interface.
MESSAGING_WHATSAPP_DRIVER="whatsapp-link"
MESSAGING_EMAIL_DRIVER="mailto"

# ── Mail MOTION sends itself ──────────────────────────────────────────────────
# Separate from the drivers above, and deliberately so. Those hand a message to
# the workshop's own WhatsApp or mail client, which is right for an invoice: the
# customer's reply belongs in the workshop's inbox. A password reset has nobody
# to hand anything to — the recipient is locked out — so it leaves the server on
# its own, through this.
#
# Unset MAIL_DRIVER and a reset is still recorded and still minted; it just
# cannot be delivered, and says so in the server log. That is the right state
# for local development. The link itself is never logged.
# MAIL_DRIVER="smtp"

# Namecheap Private Email. 465 is TLS from the first byte; 587 is STARTTLS, and
# is the one to try if an outbound firewall blocks 465.
# MAIL_SMTP_HOST="mail.privateemail.com"
# MAIL_SMTP_PORT="465"
# MAIL_SMTP_USER="no-reply@motionworkshopmanager.com"
# MAIL_SMTP_PASSWORD=""

# The From address, which is not necessarily the mailbox that authenticates. It
# must be on the domain that signs with DKIM — a From outside it fails alignment
# and gets spam-filed however correct the DNS is.
# MAIL_FROM="no-reply@motionworkshopmanager.com"
# MAIL_FROM_NAME="MOTION"
#
# The domain needs three records for any of this to be trusted. Checked with
# `npm run mail:check`, which also tries the login without sending anything:
#   MX     @                        10 mx1.privateemail.com / 10 mx2.privateemail.com
#   TXT    @                        v=spf1 include:spf.privateemail.com ~all
#   TXT    privateemail._domainkey  v=DKIM1;k=rsa;p=…   (from the Private Email dashboard)
#   TXT    _dmarc                   v=DMARC1; p=none; rua=mailto:…

# The shared secret the host's scheduler presents to POST /api/handoff/run.
# Unset or shorter than 16 characters means the endpoint is off, not open:
# a deployment that has not chosen one should not be exporting unattended.
#   curl -fsS -X POST https://motion.example/api/handoff/run \
#        -H "Authorization: Bearer $HANDOFF_SECRET"
HANDOFF_SECRET=

# ── where subscription money is paid ─────────────────────────────────────────
# Shown on the registration confirmation page and in the registration email.
#
# In configuration rather than in code for two reasons. An account number
# displayed to customers is the highest-value line in this file to an attacker
# — change it and payments go elsewhere silently, and the first symptom is a
# customer insisting they paid — so it stays out of the repository, where a
# clone would be enough to see it. And the installed edition at a council does
# not bill through Omzizi at all, so this cannot be a constant.
#
# The reference matters as much as the number: matching a deposit to a
# registration is manual, and an unmatched payment is an account nobody
# activates.
BILLING_ENTITY_NAME="Omzizi Investment CC"
BILLING_BANK_NAME="First National Bank"
BILLING_BANK_BRANCH_CODE="280475"
BILLING_BANK_ACCOUNT_NUMBER="64283593331"
BILLING_BANK_ACCOUNT_TYPE="Cheque"

# Who at MOTION hears that a workshop has registered and is waiting on
# payment — the notice that starts somebody checking the bank statement.
# Unset, it goes to MOTION_SUPPORT_EMAIL; set it to route registrations to a
# different inbox from customer support.
BILLING_NOTIFY_EMAIL="info@motionworkshopmanager.com"

# ── The front door ────────────────────────────────────────────────────────────
# Which edition this deployment serves: "cloud" (the hosted service, with
# pricing and sign-up) or "onprem" (installed on a client's own server, where
# showing a price to somebody whose procurement already bought MOTION reads as
# carelessness). Anything other than "onprem" is treated as cloud.
MOTION_EDITION=cloud

# How to reach support. Public contact details rather than secrets, but kept in
# the environment because an installed site may be supported by a reseller, and
# because a number wrong in the source is wrong on every page at once.
MOTION_SUPPORT_WHATSAPP="+264815765935"
MOTION_SUPPORT_PHONE="+264815765935"
MOTION_SUPPORT_EMAIL="info@motionworkshopmanager.com"
MOTION_SUPPORT_HOURS="Monday to Friday, 08:00-17:00 (Africa/Windhoek)"

# ── What an installed site says about itself (onprem only) ────────────────────
# Council IT asks who put this here and when. "Ask the person who left in
# March" is the answer these exist to prevent. Unset values render as a plain
# "not recorded" rather than as a blank.
MOTION_INSTALLED_BY=
MOTION_VERSION=
MOTION_DATA_LOCATION=
MOTION_SITE_ADMIN=
