# Copy to .env and fill in. Local Postgres comes from ../docker-compose.yml (docker compose up -d db).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/motion_app?schema=public"
# 32+ random bytes, e.g. `openssl rand -hex 32`. Used to derive session-token hashes.
SESSION_SECRET="change-me"

# ── File storage ──────────────────────────────────────────────────────────────
# Where uploaded files (EFT proofs of payment, photos) are kept. One codebase
# serves both: "local" writes to disk, "s3" writes to any S3-compatible bucket
# (AWS S3, Cloudflare R2, MinIO, Backblaze B2, DigitalOcean Spaces).
#
# Each stored file records the driver that wrote it, so switching is a config
# change — everything written before the switch keeps being readable.
STORAGE_DRIVER="local"

# local
STORAGE_LOCAL_ROOT=".data/attachments"

# s3 — only read when STORAGE_DRIVER="s3"
# STORAGE_S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# STORAGE_S3_BUCKET="motion-attachments"
# STORAGE_S3_REGION="auto"
# STORAGE_S3_ACCESS_KEY_ID=""
# STORAGE_S3_SECRET_ACCESS_KEY=""
# MinIO and most self-hosted gateways need the bucket in the path instead of the host.
# STORAGE_S3_FORCE_PATH_STYLE="false"
