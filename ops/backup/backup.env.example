# MOTION off-site backup configuration.
#
# Copy to /etc/motion/backup.env on the server, fill in, and lock it down:
#
#   sudo install -m 600 -o root -g root backup.env.example /etc/motion/backup.env
#
# It holds bucket credentials, so it is never committed. MOTION_BACKUP_ENV
# overrides the location if you keep it elsewhere.

# --------------------------------------------------------------- the database
# The database to dump. A ?schema=public suffix is stripped automatically, so
# the same value as the application's DATABASE_URL works unchanged.
DATABASE_URL="postgresql://motion_app:CHANGEME@localhost:5432/motion_app"

# PostgreSQL client commands. Leave these alone if the client tools are
# installed on the host. If PostgreSQL runs in a container and the host has no
# client, point them at it — the version then always matches the server, which
# is one fewer thing to get wrong:
#
#   PG_DUMP="docker exec -i motion-db pg_dump"
#   PG_DUMPALL="docker exec -i motion-db pg_dumpall"
#   PG_RESTORE="docker exec -i motion-db pg_restore"
#   PSQL="docker exec -i motion-db psql"

# ----------------------------------------------------------------- the bucket
# Any S3-compatible object store. Cloudflare R2 has no egress charge, which
# matters on a restore; Backblaze B2 is cheaper per GB. Either is fine.
S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
S3_BUCKET="motion-backups"
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# MinIO and some self-hosted stores need path-style addressing.
S3_FORCE_PATH_STYLE="false"

# Objects are written under this prefix, so one bucket can hold several
# installations. Give each site its own.
BACKUP_PREFIX="motion"

# -------------------------------------------------------------- encryption
# The public half of the backup key pair. Generate it somewhere other than
# this server (see README.md) and copy only the public half here. With this
# set, nothing readable leaves the machine: a stolen bucket is noise, and a
# compromised server can write new backups but cannot read any.
BACKUP_PUBLIC_KEY="/etc/motion/backup-public.pem"

# The private half. Deliberately NOT set on the server — restoring is done
# from wherever the key is kept.
# BACKUP_PRIVATE_KEY="/path/to/backup-private.pem"

# Uploading unencrypted is refused unless this is set. It exists so the
# refusal can be overridden deliberately rather than by forgetting.
# BACKUP_ALLOW_PLAINTEXT="false"

# ------------------------------------------------------------- attachments
# Only for STORAGE_DRIVER=local, where job-card photos and generated PDFs sit
# on this disk. With STORAGE_DRIVER=s3 they are already in a bucket; leave this
# empty rather than paying to copy them into a second one.
BACKUP_ATTACHMENTS_DIR="/var/lib/motion/attachments"

# --------------------------------------------------------------- retention
# Grandfather-father-son. KEEP_DAILY is the window that matters day to day:
# fourteen covers a mistake noticed after a long weekend. See rotate.sh for
# why there is no weekly tier.
#
# Note that the daily window counts against the monthly allowance, so
# KEEP_MONTHLY=12 yields roughly eleven months of month-end copies.
KEEP_DAILY="14"
KEEP_MONTHLY="12"
KEEP_YEARLY="7"

# ------------------------------------------------------------ verification
# A connection that may create and drop databases, used by motion-verify.sh
# for its scratch restore. Needed only where verification runs.
# VERIFY_ADMIN_URL="postgresql://postgres:CHANGEME@localhost:5432/postgres"

# ------------------------------------------------------------- the heartbeat
# A URL to hit on success. The usual way backups fail is that the job quietly
# stops running and nobody notices for months; a monitor that complains when
# this stops arriving is the cheapest possible protection against that.
# Any dead-man's-switch service works, or MOTION's own health endpoint.
# BACKUP_HEARTBEAT_URL=""
