#!/usr/bin/python3
"""Set MAIL_SMTP_PASSWORD in /etc/motion/motion.env, and nothing else.

Exists because the alternatives are all worse. Typing it into an editor needs
an editor on the box; passing it on a command line puts a live credential in
shell history and in `ps`; and echoing it to a file leaves it on the terminal.
getpass reads it without echo, and it never becomes an argument or a variable
anything else can see.
"""

import datetime
import getpass
import io
import re
import shutil
import sys

PATH = "/etc/motion/motion.env"

text = io.open(PATH, encoding="utf-8").read()

user = re.search(r"(?m)^MAIL_SMTP_USER=(.*)$", text)
prompt = "Private Email password for %s: " % (user.group(1).strip() if user else "the mailbox")

password = getpass.getpass(prompt)
if not password.strip():
    sys.exit("Nothing entered. The file is unchanged.")
if password != password.strip():
    # A pasted password often carries a trailing space or newline, which SMTP
    # rejects with the same 535 as a wrong one — indistinguishable from the
    # symptom, so it is worth refusing rather than silently trimming.
    sys.exit("That has whitespace at one end. Paste it again without.")
if password.startswith("MII"):
    # The DKIM public key starts this way. It is published in DNS, it is not a
    # credential, and it sits next to the password in the dashboard.
    sys.exit("That looks like the DKIM public key, not the mailbox password.")

stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
shutil.copy2(PATH, "%s.bak-%s" % (PATH, stamp))

new, count = re.subn(r"(?m)^MAIL_SMTP_PASSWORD=.*$", "MAIL_SMTP_PASSWORD=" + password, text)
if count != 1:
    sys.exit("Expected exactly one MAIL_SMTP_PASSWORD line, found %d. Nothing written." % count)

io.open(PATH, "w", encoding="utf-8").write(new)
print("Written. %d characters, and the file is backed up at %s.bak-%s" % (len(password), PATH, stamp))
print("Nothing was echoed and nothing is in your shell history.")
