# MOTION production environment — server1.motionworkshopmanager.com
#
#   sudo install -m 600 -o root -g root motion.env.example /etc/motion/motion.env
#   sudo $EDITOR /etc/motion/motion.env
#
# Holds every secret the deployment has. Never in the repository, never in a
# `docker run` command where `ps` would show it.

# ── the database ─────────────────────────────────────────────────────────────
# Both generated once, with `openssl rand -hex 24`, and then left alone. They
# are read when the data directory is first created; changing them afterwards
# changes nothing, because the roles already exist.
POSTGRES_SUPERUSER_PASSWORD=
MOTION_DB_PASSWORD=

# ── the application ──────────────────────────────────────────────────────────
# `openssl rand -hex 32`. Sessions and customer share links are signed with it.
# Changing it signs every open session out and breaks every live share link,
# so set it once at install and never rotate it casually.
SESSION_SECRET=

# Pin to a commit for a deployment you can reason about; :latest is what you
# want only while nothing is live yet.
#   MOTION_IMAGE=ghcr.io/gausabner/motion-workshop-manager:9f9db46...
MOTION_IMAGE=ghcr.io/gausabner/motion-workshop-manager:latest

MOTION_EDITION=hosted
MOTION_VERSION=
MOTION_INSTALLED_BY=MOTION Dynamic Systems

# Shown to anyone who asks where their data is. The honest answer for this
# server, and the one a council will ask for: Namecheap's VPS estate is in the
# United States, and they confirmed there is no EU option on VPS plans.
MOTION_DATA_LOCATION=Phoenix, Arizona, United States

# ── support, as the help and support pages display it ────────────────────────
MOTION_SUPPORT_WHATSAPP=+264815765935
MOTION_SUPPORT_PHONE=+264815765935
MOTION_SUPPORT_EMAIL=gausabner@gmail.com
MOTION_SUPPORT_HOURS=
MOTION_SITE_ADMIN=

# ── storage ──────────────────────────────────────────────────────────────────
# "local" keeps attachments on the `attachments` volume, which ops/backup
# archives nightly. Switch to "s3" once there is a bucket, and the backup stops
# copying them because they are already off the machine.
STORAGE_DRIVER=local

# ── the accounting hand-off ──────────────────────────────────────────────────
# Only needed if the nightly journal endpoint is called from outside.
HANDOFF_SECRET=

# ── the way in ───────────────────────────────────────────────────────────────
# From Cloudflare → Zero Trust → Networks → Tunnels → your tunnel → Install.
# This token lets anything holding it serve traffic as your tunnel, so it is as
# sensitive as the rest of this file.
TUNNEL_TOKEN=
