# MOTION production environment
#
# For server1.motionworkshopmanager.com — which is the machine's own hostname
# and not a DNS record. Nothing resolves it: traffic reaches the app through the
# Cloudflare Tunnel, so the host has no public A record. Reach it with
# `ssh motion-root` (see docs/launch-runbook.md section 2).
#
#   sudo install -m 600 -o root -g root motion.env.example /etc/motion/motion.env
#   sudo $EDITOR /etc/motion/motion.env
#
# Holds every secret the deployment has. Never in the repository, never in a
# `docker run` command where `ps` would show it.

# ── the database ─────────────────────────────────────────────────────────────
# Both generated once, with `openssl rand -hex 24`, and then left alone. They
# are read when the data directory is first created; changing them afterwards
# changes nothing, because the roles already exist.
POSTGRES_SUPERUSER_PASSWORD=
MOTION_DB_PASSWORD=

# ── the application ──────────────────────────────────────────────────────────
# `openssl rand -hex 32`. Sessions and customer share links are signed with it.
# Changing it signs every open session out and breaks every live share link,
# so set it once at install and never rotate it casually.
SESSION_SECRET=

# Pin to a commit for a deployment you can reason about; :latest is what you
# want only while nothing is live yet.
#   MOTION_IMAGE=ghcr.io/gausabner/motion-workshop-manager:9f9db46...
MOTION_IMAGE=ghcr.io/gausabner/motion-workshop-manager:latest

MOTION_EDITION=hosted
MOTION_VERSION=
MOTION_INSTALLED_BY=MOTION Dynamic Systems

# Shown to anyone who asks where their data is. The honest answer for this
# server, and the one a council will ask for: Namecheap's VPS estate is in the
# United States, and they confirmed there is no EU option on VPS plans.
MOTION_DATA_LOCATION=Phoenix, Arizona, United States

# ── support, as the help and support pages display it ────────────────────────
MOTION_SUPPORT_WHATSAPP=+264815765935
MOTION_SUPPORT_PHONE=+264815765935
MOTION_SUPPORT_EMAIL=gausabner@gmail.com
MOTION_SUPPORT_HOURS=
MOTION_SITE_ADMIN=

# ── storage ──────────────────────────────────────────────────────────────────
# "local" keeps attachments on the `attachments` volume, which ops/backup
# archives nightly. Switch to "s3" once there is a bucket, and the backup stops
# copying them because they are already off the machine.
STORAGE_DRIVER=local

# ── the address this site is reached at ──────────────────────────────────────
# Every link MOTION hands out — a customer's share link, a reset mail — is
# built from this. No trailing slash. The deployment refuses to start without
# it, on purpose: a password-reset mail has no request to infer a host from, so
# the alternative is a link nobody can click.
APP_URL=https://motionworkshopmanager.com

# ── mail MOTION sends itself ─────────────────────────────────────────────────
# Only the password reset, today. Everything else MOTION sends is a hand-off —
# a wa.me or mailto: link the workshop clicks in their own client — but the
# person who needs a reset is locked out and there is nobody to hand it to.
#
# Namecheap Private Email. 465 is TLS from the first byte; try 587 (STARTTLS)
# if something outbound blocks 465. The password is the mailbox's own, from the
# Private Email dashboard.
#
# Leave MAIL_DRIVER empty and a reset is still recorded and still minted; it
# just cannot be sent, and logs loudly. The link itself is never logged.
#
# The domain needs MX, SPF, DKIM (selector `privateemail`) and DMARC for any of
# this to be believed — `npm run mail:check` verifies all four and the login.
# Runbook section 8 has the records.
MAIL_DRIVER=smtp
MAIL_SMTP_HOST=mail.privateemail.com
MAIL_SMTP_PORT=465

# The mailbox that logs in. It must be a real mailbox — `no-reply@` here is an
# **alias** on `info@`, and an alias cannot authenticate. Getting this wrong
# costs an hour, because the rejection is a bare `535` either way; the only tell
# is that an unknown user and a wrong password word it slightly differently.
MAIL_SMTP_USER=info@motionworkshopmanager.com
# Set it with ops/server/motion-set-mail-password rather than an editor — the
# server has no nano, and this keeps the credential off the terminal, out of
# shell history and out of `ps`. It is the mailbox's own webmail password.
MAIL_SMTP_PASSWORD=

# The From address, which need not be the mailbox that authenticates and should
# not be one anybody reads. Sending as the `no-reply@` alias while logged in as
# `info@` is tested and allowed, and it is the better arrangement: a reply to a
# reset bounces visibly instead of sitting unread in a mailbox nobody opens.
#
# It must be on the DKIM-signed domain — a From outside it fails alignment and
# is spam-filed however correct the records are.
MAIL_FROM=no-reply@motionworkshopmanager.com
MAIL_FROM_NAME=MOTION

# ── the accounting hand-off ──────────────────────────────────────────────────
# Only needed if the nightly journal endpoint is called from outside.
HANDOFF_SECRET=

# ── the way in ───────────────────────────────────────────────────────────────
# From Cloudflare → Zero Trust → Networks → Tunnels → your tunnel → Install.
# This token lets anything holding it serve traffic as your tunnel, so it is as
# sensitive as the rest of this file.
TUNNEL_TOKEN=
