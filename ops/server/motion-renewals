#!/usr/bin/env bash
# The daily renewal run: reminders a week before a subscription is due, and
# read-only once its grace period has passed. Called by motion-renewals.timer;
# safe to run by hand at any time, as often as you like — every step is keyed
# to the period it is about, so nothing is sent twice.
#
#   /opt/motion/ops/server/motion-renewals
#
# The request is made from inside the app container, to the app itself, so it
# never leaves the machine. The secret it presents is read there too, from the
# container's own environment — it is never on this command line or in a log.
set -euo pipefail

cd /opt/motion/ops/server
exec docker compose --env-file /etc/motion/motion.env exec -T app node -e '
const secret = process.env.BILLING_TICK_SECRET || "";
if (secret.length < 32) { console.error("BILLING_TICK_SECRET is not set (32+ characters) in /etc/motion/motion.env, so renewals cannot run."); process.exit(2); }
fetch("http://127.0.0.1:" + (process.env.PORT || 3000) + "/api/internal/renewals", { method: "POST", headers: { authorization: "Bearer " + secret } })
  .then(async (r) => { const body = await r.text(); console.log(r.status, body); process.exit(r.ok ? 0 : 1); })
  .catch((e) => { console.error(e.message); process.exit(1); });
'
